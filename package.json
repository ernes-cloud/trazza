{
  "name": "web-app",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host :: --port 3000",
    "prebuild": "node tools/generate-llms.js || exit 0",
    "build": "vite build",
    "postbuild": "node tools/generate-seo.js && node tools/prerender.mjs && node tools/checkInlineStyles.mjs && node tools/checkRawKeys.js",
    "build:deploy": "node tools/buildDeploy.mjs",
    "preview": "vite preview --host :: --port 3000",
    "lint": "eslint src server plugins tools --quiet",
    "test": "vitest run",
    "test:pg": "node tools/run-pg-tests.mjs",
    "test:watch": "vitest",
    "mutants": "node tools/mutants/run-mutants.mjs",
    "test:e2e": "node e2e/import-degiro.smoke.mjs",
    "test:e2e:dashboard": "node e2e/dashboard.smoke.mjs",
    "test:e2e:onboarding": "node e2e/onboarding.smoke.mjs",
    "test:e2e:app-i18n": "node e2e/app-i18n-delayed.smoke.mjs"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@supabase/supabase-js": "2.30.0",
    "@tanstack/react-query": "^5.100.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "framer-motion": "^11.15.0",
    "i18next": "^26.1.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.10.3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.26.3",
    "@babel/parser": "^7.26.3",
    "@babel/traverse": "^7.26.4",
    "@babel/types": "^7.26.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.37.0",
    "vite": "^4.4.5",
    "vitest": "^2.1.9"
  }
}
